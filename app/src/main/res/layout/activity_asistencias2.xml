<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/asistencias2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_pantalla_asistencias"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <com.example.clubdeportivoteam5kotlin.FormCuerpoView
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:tituloText="Ingrese DNI">

            <com.example.clubdeportivoteam5kotlin.FormSlot
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:id="@+id/asistDni"/>
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Buscar"
                    android:textSize="20sp"
                    android:id="@+id/btnBuscarasist"/>

            </com.example.clubdeportivoteam5kotlin.FormSlot>

        </com.example.clubdeportivoteam5kotlin.FormCuerpoView>

    </LinearLayout>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:text="Regresar"
        android:textSize="22sp"
        android:layout_marginBottom="18dp"
        android:id="@+id/btnregasist2"/>

</LinearLayout>