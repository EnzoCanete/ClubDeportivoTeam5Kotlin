<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pagosEscanearQr"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AvisoExito"
    android:orientation="vertical"
    android:gravity="top"
    android:padding="80dp"
    android:background="@color/fondo_uno"
    >

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Escanea el QR"
        android:textSize="36sp"
        android:textAlignment="center"
        android:layout_marginBottom="100dp"/>

    <ImageView
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_qr_placeholder"
        android:layout_marginBottom="100dp"/>

    <Button
        android:id="@+id/btnMenuprincipal"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="Compartir Link"
        android:textStyle="normal"
        android:layout_marginBottom="16dp"/>

</LinearLayout>