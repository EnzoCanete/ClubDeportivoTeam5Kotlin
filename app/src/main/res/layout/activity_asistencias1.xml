<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/asistencias1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_pantalla_asistencias"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.example.clubdeportivoteam5kotlin.MenuItem
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/asistProfesor"
            app:icono="@drawable/icono_profesor"
            app:menuTitulo="Profesor" />

        <com.example.clubdeportivoteam5kotlin.MenuItem
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/menuListadoVencidos"
            app:icono="@drawable/icono_alumnos"
            app:menuTitulo="Alumno" />

    </LinearLayout>
</LinearLayout>